# Matugen-generated palette outputs (regenerated on every wallpaper switch
# via sway-wall.sh; templates live in matugen/.config/matugen/templates/)
sway/.config/sway/colors
sway/.config/sway/swaylock-config
mako/.config/mako/colors
swayosd/.config/swayosd/style.css
rofi/.config/rofi/colors.rasi
foot/.config/foot/colors.ini
alacritty/.config/alacritty/colors.toml
waybar/.config/waybar/colors.css
btop/.config/btop/themes/
gtk/.config/gtk-3.0/gtk.css
gtk/.config/gtk-4.0/gtk.css
gtk/.config/gtk-4.0/gtk-dark.css
nvim/.config/nvim/lua/matugen-colors.lua
# ~/.config/starship.toml is generated directly by matugen
# (template matugen/.config/matugen/templates/starship.toml
# is the versioned source of truth) — never tracked, never stowed.
# Current wallpaper pointer, rewritten by sway-wall.sh on every switch
sway/.config/sway/wallpaper
nvim/.config/nvim/starter/
