#!/usr/bin/env bash
# Open Files (nautilus) in the active terminal's current working directory.
set -euo pipefail

terminal_pid=$(swaymsg -t get_tree 2>/dev/null | jq -r '.. | objects | select(.focused == true) | .pid // empty' 2>/dev/null | head -n 1 || true)
# Kitty single-instance daemon socket (login kitty carries --listen-on).
# The old arch-kitty-$pid name no longer exists; try the live daemon
# socket first, fall back to the /proc PID tree.
kitty_socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/kitty.sock"
cwd=""

if [[ -S $kitty_socket ]]; then
  if command -v kitty >/dev/null 2>&1; then
    cwd=$(kitty @ --to "unix:$kitty_socket" ls 2>/dev/null |
      jq -r '.. | objects | select(.is_focused == true) | .cwd // empty' 2>/dev/null | head -n 1 || true)
  elif command -v kitten >/dev/null 2>&1; then
    cwd=$(kitten @ --to "unix:$kitty_socket" ls --match "state:focused" 2>/dev/null |
      jq -r '.[].tabs[].windows[].cwd // empty' 2>/dev/null | head -n 1 || true)
  fi
fi

if [[ -z $cwd && -n ${terminal_pid:-} ]]; then
  shell_pid=$(pgrep -P "$terminal_pid" 2>/dev/null | tail -n1 || true)
  if [[ -n $shell_pid ]]; then
    cwd=$(readlink -f "/proc/$shell_pid/cwd" 2>/dev/null)
    shell=$(readlink -f "/proc/$shell_pid/exe" 2>/dev/null)
    if ! grep -Fqsx "$shell" /etc/shells; then
      cwd=""
    fi
  fi
fi

[[ -d $cwd ]] || cwd="$HOME"

exec setsid "$HOME/.local/bin/nautilus-gnome" --new-window "$cwd"
