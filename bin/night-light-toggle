#!/usr/bin/env bash
# Night light toggle (hyprsunset).
set -euo pipefail
command -v hyprsunset >/dev/null 2>&1 || { notify-send "Night Light" "hyprsunset not installed" -u critical; exit 1; }
if pgrep -x hyprsunset >/dev/null; then
  pkill -x hyprsunset
  notify-send "Night Light" "Disabled"
else
  hyprsunset --temperature 4000 &
  disown
  notify-send "Night Light" "Enabled (4000K)"
fi
