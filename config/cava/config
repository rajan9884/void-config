[general]
mode = normal
framerate = 60
sensitivity = 60
autosens = 0
bar_width = 1.5
bar_spacing = 0.4
max_height = 100

[input]
method = pipewire
source = auto

[output]
method = noncurses

[color]
# Colors are generated by theme.py into ~/.config/cava/themes/theme
theme = 'theme'

[smoothing]
noise_reduction = 90

