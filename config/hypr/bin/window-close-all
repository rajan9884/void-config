#!/usr/bin/env bash
# Close all windows on Hyprland (sway fallback kept for parity).
set -euo pipefail
if [ -n "${SWAYSOCK:-}" ]; then
  swaymsg '[app_id=".*"] kill' 2>/dev/null || true
else
  hyprctl clients -j 2>/dev/null | jq -r '.[].address' | while read -r addr; do
    [ -n "$addr" ] && hyprctl dispatch closewindow "address:$addr" >/dev/null 2>&1 || true
  done
fi
notify-send "Windows" "All windows closed"
