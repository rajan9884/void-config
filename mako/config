# ── mako notification daemon (sway/Void port of swaync) ──
# Colors appended from matugen (~/.config/mako/colors) on every wallpaper switch.
font=JetBrainsMono Nerd Font 11
width=380
height=180
margin=12
padding=14
border-size=2
border-radius=12
default-timeout=5000
ignore-timeout=0
layer=top
anchor=top-right
output=
icons=1
max-icon-size=48
include=~/.config/mako/colors
