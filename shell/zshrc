# ~/.zshrc — Arch dotfiles (task-shell style).
#
# Guarded tool inits: a missing tool is skipped silently, so the shell always
# starts clean even mid-install (nothing here may error under `set -e`).
# Everything below matches the desktop's other shells.

# ── Aliases ──
alias ..="cd ../"
alias ff="fzf --preview 'bat --color=always {}'"
alias open='zathura'
alias vsv='sudo vsv'
alias grep='grep --color=auto'
alias vp-sync='XBPS_DISTDIR="$HOME/.local/share/pkg/void-packages" "$HOME/.local/share/pkg/void-packages/vp-sync"'
export XBPS_DISTDIR="$HOME/.local/share/pkg/void-packages"
# Dual-GitHub helpers: git-work / git-personal / git-whoami
[ -f "$HOME/void-config/shell/git-accounts.sh" ] && source "$HOME/void-config/shell/git-accounts.sh"

# Monochrome eza
export EZA_COLORS="uu=bright-black:gu=bright-black:da=bright-black:ur=white:uw=bright-black:ux=white:ue=bright-black:gr=bright-black:gw=bright-black:gx=white:tr=bright-black:fi=white:di=bright-white:ln=bright-black:pi=bright-black:so=bright-black:bd=bright-black:cd=bright-black:or=bright-black:mi=bright-black:ex=white"

alias ls='eza --icons=auto'
alias ll='eza -lah --icons=auto --git'
alias la='eza -a --icons=auto'
alias lt='eza --tree --icons=auto'

# Grayscale completion list colors (see Tab completion below).

# ── Prompt (starship + matugen palette) ──
# ~/.config/starship.toml is generated by matugen on every wallpaper switch
# (templates/starship.toml → truecolor hex palette), so the prompt follows
# the desktop theme in every terminal — including Zed, whose Aura palette
# no longer affects it (no ANSI magenta/cyan, no powerline caps).
# bash inits starship too (see shell/bashrc).
if command -v starship >/dev/null 2>&1; then eval "$(starship init zsh)"; fi




# ── Command history ──
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS

# ── Autosuggestions (up-arrow cycles suggestions) ──
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'

# ── Tab completion (zsh-completions + compinit) ──
# compinit's freshness check stats every fpath dir (~600ms); -C reuses the
# dump (~30ms). Re-dump at most once a day so new completions still register.
fpath=(/usr/share/zsh/site-functions $fpath)
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then compinit; else compinit -C; fi
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' verbose true

# Grayscale completion colors
zstyle ':completion:*' list-colors \
  '=(#b)*(=0)=38;5;250' \
  '=(#b)*(=1)=38;5;255' \
  '=(#b)*(=2)=38;5;245' \
  '=(#b)*(=3)=38;5;240'

# ── Syntax highlighting (MUST be LAST plugin) ──
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Grayscale
ZSH_HIGHLIGHT_STYLES[command]='fg=white'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=white'
ZSH_HIGHLIGHT_STYLES[function]='fg=white'
ZSH_HIGHLIGHT_STYLES[alias]='fg=white'
ZSH_HIGHLIGHT_STYLES[path]='fg=245'
ZSH_HIGHLIGHT_STYLES[comment]='fg=240'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=245'

# ── Editor ──
export EDITOR="nvim" VISUAL="nvim"
export FZF_DEFAULT_OPTS="--height 90% --reverse --border"

# ── Speed tools (zoxide/fzf/yazi/atuin/direnv) ──
if command -v zoxide >/dev/null 2>&1; then eval "$(zoxide init zsh --cmd z)"; fi
if [ -f /usr/share/fzf/key-bindings.zsh ]; then source /usr/share/fzf/key-bindings.zsh; fi
if [ -f /usr/share/fzf/completion.zsh ]; then source /usr/share/fzf/completion.zsh; fi
# Atuin owns Ctrl-R; fzf keeps Ctrl-T + Alt-C.
if command -v atuin >/dev/null 2>&1; then eval "$(atuin init zsh --disable-up-arrow)"; fi
if command -v direnv >/dev/null 2>&1; then eval "$(direnv hook zsh)"; fi

# yazi: `y` cds into the directory you exit in
y() {
  local tmp="$(mktemp -t yazi-cwd.XXXXXX)"
  command yazi "$@" --cwd-file="$tmp"
  local cwd="$(cat -- "$tmp" 2>/dev/null)"
  rm -f -- "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && cd -- "$cwd"
}

# ~/.local/bin carries the repo helpers (arch-wallpaper-picker, …).
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH";; esac

# Desktop info on login shells only: fastfetch's static output stays in
# the terminal scrollback, so interactive subshells and every new tab
# skip it (they inherit the login shell's output already visible).
[[ -o login ]] && command -v fastfetch >/dev/null 2>&1 && fastfetch

# Added by Antigravity CLI installer
export PATH="$HOME/.opencode/bin:$PATH"

# kilo
export PATH=/home/rajan/.kilo/bin:$PATH
