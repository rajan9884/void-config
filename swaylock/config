# ── swaylock (Void port of hyprlock.conf — clock + staged wallpaper bg) ──
# Palette comes from matugen (~/.config/sway/swaylock-colors).
daemonize
show-failed-attempts
font=JetBrainsMono Nerd Font
clock
indicator
indicator-radius=110
indicator-thickness=8
screenshots
effect-blur=7x5
effect-vignette=0.5:0.5
grace=0
fade-in=0.2
include=~/.config/sway/swaylock-colors
